# ===== Обязательно =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Адрес сайта (репозиторий voidplay-webapp на GitHub Pages), со слэшем в конце
WEBAPP_URL=https://твой-ник.github.io/voidplay-webapp/
# Твой Telegram id (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# ===== Сервер =====
PORT=8080
# Кому можно ходить в API: адрес GitHub Pages без пути (или * — всем)
ALLOWED_ORIGINS=https://твой-ник.github.io
# Сайт отдельно, поэтому сам сервер его не раздаёт
SERVE_STATIC=0

# ===== Канал и ссылки =====
# Бот должен быть админом канала, чтобы проверять подписку
CHANNEL=@voidplay
CHANNEL_URL=https://t.me/voidplay
SUPPORT_URL=https://t.me/voidplay_support
GIFTS_ACCOUNT=@voidplay

# ===== Экономика (1 ⭐ в игре = 1 Telegram Star) =====
SUBSCRIBE_REWARD=15
DAILY_REWARD=5
REF_PER_FRIEND=10
MIN_WITHDRAW=100
HOUSE_EDGE=0.10
MAX_CHANCE=0.75
