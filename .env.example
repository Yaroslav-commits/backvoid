# Скопируй в .env (или впиши эти переменные в панели bothost.ru)

# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Адрес сайта (Web App), который откроется по кнопке «Играть»
WEBAPP_URL=https://yaroslav-commits.github.io/voidplayfiles/

# Порт, который слушает API. На bothost бери тот, что указан в панели
PORT=8080

# С каких сайтов можно ходить в API. * — с любых
ALLOWED_ORIGINS=https://yaroslav-commits.github.io

# Название проекта (меняется только тут)
APP_NAME=Void Play

# Стартовые звёзды новичку («заработок без вложений»), 0 — выключить
WELCOME_BONUS=10

# Канал для задания «подпишись» (бот должен быть админом канала)
CHANNEL=@testkanalbot
CHANNEL_URL=https://t.me/testkanalbot
SUPPORT_URL=https://t.me/Hanoru

# ---------- PvP ----------
# Комиссия с выигрыша в PvP (0.10 = 10%). Берётся только со ставок проигравших
PVP_FEE=0.10
# Сколько секунд идёт раунд после входа второго игрока
PVP_ROUND_SECONDS=20

# ---------- Апгрейдер ----------
# Максимальная ставка = эта доля от цены цели (0.8 → за подарок в 1000 ⭐ максимум 800 ⭐)
UPGRADE_MAX_RATIO=0.8

# ---------- Цены подарков ----------
# telegram — каталог и цены сами берутся из Telegram и обновляются; manual — список GIFTS в config.py
GIFTS_SOURCE=telegram
GIFTS_SYNC_MINUTES=30

# ---------- Пополнение в TON ----------
# Адрес твоего TON-кошелька (пусто — оплата TON выключена)
TON_WALLET=
# Сколько $ стоит 1 звезда при оплате в TON и твоя комиссия сверху (0.05 = 5%)
STAR_USD=0.02
TON_FEE=0
# Запасной курс TON в $, если биржа не отвечает (0 — тогда оплата TON временно недоступна)
TON_USD=0

# ---------- Вывод и NFT-подарки ----------
# Твоя комиссия с любого вывода (0.03 = 3%)
WITHDRAW_FEE=0.03
# Сколько звёзд Telegram берёт за передачу NFT (платит игрок при выводе)
NFT_TRANSFER_STARS=25
# Необязательно: JSON с флорами коллекций — цены NFT обновятся сами. Без него: /floor Коллекция цена
NFT_FLOORS_URL=
NFT_FLOORS_UNIT=ton
