# Скопируй в .env (или впиши эти переменные в панели bothost.ru)

# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# Адрес сайта (Web App), который откроется по кнопке «Играть»
WEBAPP_URL=https://yaroslav-commits.github.io/voidplayfiles/

# Порт, который слушает API. На bothost бери тот, что указан в панели
PORT=8080

# С каких сайтов можно ходить в API. * — с любых
ALLOWED_ORIGINS=https://yaroslav-commits.github.io

# Название проекта (меняется только тут)
APP_NAME=Void Play

# Канал для задания «подпишись» (бот должен быть админом канала)
CHANNEL=@testkanalbot
CHANNEL_URL=https://t.me/testkanalbot
SUPPORT_URL=https://t.me/Hanoru
