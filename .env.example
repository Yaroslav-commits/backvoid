# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token

# HTTPS-адрес, где лежит фронтенд (index.html). Telegram открывает только https://
WEBAPP_URL=https://your-domain.com/

# 1 — main.py сам раздаёт фронтенд на SERVE_PORT (дальше прокинь HTTPS через nginx / cloudflared / ngrok)
# 0 — фронтенд хостится отдельно (Vercel, Netlify, GitHub Pages)
SERVE_STATIC=1
SERVE_HOST=0.0.0.0
SERVE_PORT=8080
